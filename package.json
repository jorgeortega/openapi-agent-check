{
  "name": "openapi-agent-check",
  "version": "1.2.0",
  "description": "Score how well AI agents will use your API, 0-100, from its OpenAPI 3.0/3.1 spec: 13 rules for operationIds, descriptions, parameters, examples, schemas, errors, pagination, auth, idempotency and tool count. --fix writes the rules-only fixes into your spec.",
  "keywords": [
    "openapi",
    "ai-agents",
    "mcp",
    "llm",
    "tool-calling",
    "api",
    "lint",
    "agent-readiness"
  ],
  "homepage": "https://github.com/jorgeortega/openapi-agent-check#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgeortega/openapi-agent-check.git"
  },
  "bugs": "https://github.com/jorgeortega/openapi-agent-check/issues",
  "license": "MIT",
  "author": "Latitude 10 (October Moon LLC) <info@latitude10.tech> (https://latitude10.tech)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spectral": {
      "types": "./dist/spectral.d.ts",
      "import": "./dist/spectral.js",
      "default": "./dist/spectral.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "openapi-agent-check": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "peerDependencies": {
    "@stoplight/spectral-core": "^1.18.0"
  },
  "peerDependenciesMeta": {
    "@stoplight/spectral-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@stoplight/spectral-core": "^1.24.0",
    "@stoplight/spectral-parsers": "^1.0.5",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
